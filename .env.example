# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hotelpro?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/hotelpro
# Note: If unset, HotelPro automatically runs in Local Development / Memory Seed mode for live preview.
MONGODB_URI=

# JWT Authentication
JWT_SECRET=hotelpro_super_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Email Notifications (Nodemailer SMTP) - Optional for demo mode
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HotelPro Concierge <noreply@hotelpro.com>"

# Payment Gateways (Optional: If unset, HotelPro operates in Verified DEMO Payment mode)
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Image Upload Storage (Cloudinary) - Optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
